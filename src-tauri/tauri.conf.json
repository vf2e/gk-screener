{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobScreener",
  "version": "0.1.0",
  "identifier": "com.wangchang.jobscreener",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "岗位筛选器 · 国考职位筛选与冲稳保分档",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "国考职位筛选与冲稳保分档",
    "longDescription": "导入国考/省考职位表，按学历、专业、政治面貌、基层年限等条件筛选，并按岗位属性给出竞争压力分与冲稳保分档。"
  }
}
